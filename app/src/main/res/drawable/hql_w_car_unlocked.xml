<?xml version="1.0" encoding="utf-8"?>
<!-- Botón «Cerrar» del widget con el coche abierto: rojo tenue (hql_error al 18 %) y filo rojo: aviso. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/hql_ripple">
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#2EFF6B7A" />
            <stroke
                android:width="1dp"
                android:color="@color/hql_error" />
        </shape>
    </item>
</ripple>
