<?xml version="1.0" encoding="utf-8"?>
<!-- Botón «Abrir» del widget con el coche cerrado: verde tenue (hql_ok al 18 %) y filo verde: está seguro. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/hql_ripple">
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#2E4CFF9F" />
            <stroke
                android:width="1dp"
                android:color="@color/hql_ok" />
        </shape>
    </item>
</ripple>
